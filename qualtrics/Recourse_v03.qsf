:"QID70"},{"Type":"Question","QuestionID":"QID72"},{"Type":"Question","QuestionID":"QID73"},{"Type":"Question","QuestionID":"QID74"},{"Type":"Question","QuestionID":"QID75"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}}]},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Type":"Root","FlowID":"FL_1","Flow":[{"Type":"EmbeddedData","FlowID":"FL_2","EmbeddedData":[{"Description":"ui_base_url","Type":"Custom","Field":"ui_base_url","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html"},{"Description":"xaiType","Type":"Custom","Field":"xaiType","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"counterfactual"},{"Description":"Create New Field or Choose From Dropdown...","Type":"Recipient","Field":"Create New Field or Choose From Dropdown...","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"training_log_json","Type":"Custom","Field":"training_log_json","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"[]"},{"Description":"testing_log_json","Type":"Custom","Field":"testing_log_json","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"[]"}]},{"Type":"EmbeddedData","FlowID":"FL_3","EmbeddedData":[{"Description":"appId","Type":"Custom","Field":"appId","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"housing"}]},{"Type":"Standard","ID":"BL_5cCx0dF9dBRyR4W","FlowID":"FL_6","Autofill":[]},{"Type":"Standard","ID":"BL_bOEr2QTL2wESbqu","FlowID":"FL_7","Autofill":[]},{"Type":"Standard","ID":"BL_eXxzjmRQ8gb7FGu","FlowID":"FL_8","Autofill":[]},{"Type":"Standard","ID":"BL_aUXleLP5DOWgqR8","FlowID":"FL_9","Autofill":[]},{"Type":"Standard","ID":"BL_3fJJUKH6EXaeRIq","FlowID":"FL_10","Autofill":[]},{"Type":"Standard","ID":"BL_6S8eO7ATYBdYM3I","FlowID":"FL_11","Autofill":[]},{"Type":"BlockRandomizer","FlowID":"FL_12","SubSet":2,"Flow":[{"Type":"Standard","ID":"BL_5aT4RYQul04UaHA","FlowID":"FL_13","Autofill":[]},{"Type":"Standard","ID":"BL_3W1PIk3tbtEX0BE","FlowID":"FL_14","Autofill":[]}]},{"Type":"Standard","ID":"BL_d07rL5ybaNgQsMm","FlowID":"FL_15","Autofill":[]}],"Properties":{"Count":15}}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"b0d3842b-c573-4a9b-83e5-f1cbf74af2d8"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"20","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"RS","PrimaryAttribute":"RS_57nH6bcReVak27c","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[{"Description":"","ID":"SC_cVbqOvGeKDU6Ck6","Name":"Score"}],"ScoringCategoryGroups":[],"DefaultScoringCategory":"SC_cVbqOvGeKDU6Ck6","ScoringSummaryCategory":"SC_cVbqOvGeKDU6Ck6","ScoringSummaryAfterQuestions":false,"ScoringSummaryAfterSurvey":0,"AutoScoringCategory":null,"IgnoreNullValues":true}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"nus","SkinType":"templated","Skin":{"brandingId":"8654048777","templateId":"*base","overrides":{"questionText":{"size":"20px"},"layout":{"spacing":0}}},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CT9JVFGA","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"SurveyName":"Recourse v0.3","CustomStyles":{"customCSS":".Skin .SkinInner {min-width: 1200px !important;}\n\n#xai_train, #predict_xai_train {\n    margin-bottom: 0px; \/* Adjust this value as needed *\/\n    margin-top: 0px\n}"}}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Training","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1>Training<\/h1>\n<br>\n<p id=\"cf-training-intro-copy\"><\/p>","DefaultChoices":false,"DataExportTag":"Q25","QuestionID":"QID11","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Training","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var domain = String(Qualtrics.SurveyEngine.getEmbeddedData('appId') || 'housing').toLowerCase();\n  var explanation = String(Qualtrics.SurveyEngine.getEmbeddedData('xaiType') || 'attribution').toLowerCase();\n  var text = document.getElementById('cf-training-intro-copy');\n  if (!text) return;\n  if ('training' === 'training') {\n    var review = explanation === 'attribution'\n      ? 'review the correct answer and the influence explanation'\n      : explanation === 'counterfactual'\n      ? 'review the correct answer and the counter-example explanation'\n      : 'review the correct answer';\n    text.innerHTML = domain === 'safelimit'\n      ? 'You will see <b>10 driver profiles<\/b>. Predict Above Limit or Below Limit, then ' + review + '.'\n      : 'You will see <b>10 house profiles<\/b>. Predict Cheap or Expensive, then ' + review + '.';\n  } else {\n    text.innerHTML = domain === 'safelimit'\n      ? 'You will complete two five-profile phases: Above Limit to Below Limit and Below Limit to Above Limit. Qualtrics randomizes which phase comes first.'\n      : 'You will complete two five-profile phases: Cheap to Expensive and Expensive to Cheap. Qualtrics randomizes which phase comes first.';\n  }\n});\nQualtrics.SurveyEngine.addOnReady(function () {});\nQualtrics.SurveyEngine.addOnUnload(function () {});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Training case Study the profile, then predict the AI output.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-study-root\" data-phase=\"training\" class=\"cf-study-root\">\n\t<br>\n  <h2 id=\"cf-case-title\">Training case<\/h2>\n\t<br>\n\t<p>Study the profile, then predict the AI output.<\/p>\n  <iframe id=\"cf-case-frame\" title=\"Training profile\" style=\"width:100%;height:420px;border:0\"><\/iframe>\n  <div id=\"cf-training-answer\" class=\"cf-training-answer\" hidden><\/div>\n  <p id=\"cf-status\" class=\"cf-status\" aria-live=\"polite\"><\/p>\n<\/div><style>.cf-study-root{font-size:18px;max-width:1050px;margin:0 auto}.cf-training-answer{display:flex;gap:12px;justify-content:center;margin:18px 0}.cf-answer-button{border:1px solid #243447;border-radius:6px;background:#fff;padding:11px 22px;cursor:pointer;font-size:17px}.cf-answer-button:disabled{cursor:default;opacity:.7}.cf-status{min-height:1.5em;font-weight:600}.cf-correct{color:#217a45}.cf-incorrect{color:#b33a3a}<\/style>","QuestionJS":"\/*\n * Shared JavaScript for the training question and both testing questions.\n *\n * Required question HTML:\n *   Training: <div id=\"cf-study-root\" data-phase=\"training\">\n *   Testing:  <div id=\"cf-study-root\" data-phase=\"test\" data-test-label=\"0|1\">\n *\n * Loop & Merge field 1 is 0-9 for training and 0-4 for each testing block.\n *\/\nQualtrics.SurveyEngine.addOnload(function () {\n    \"use strict\";\n\n    var question = this;\n    var root = document.getElementById(\"cf-study-root\");\n    if (!root) return;\n\n    var CASE_IDS = {\n        housing: {\n            training: [14693, 13350, 2968, 15034, 4666, 8187, 6557, 2898, 2864, 12633],\n            test: {\n                0: [3174, 2275, 675, 102, 577],\n                1: [2447, 1751, 553, 172, 2728]\n            }\n        },\n        safelimit: {\n            training: [610, 1025, 1230, 960, 239, 124, 143, 131, 213, 322],\n            test: {\n                0: [87, 203, 106, 143, 300],\n                1: [98, 261, 4, 209, 245]\n            }\n        }\n    };\n    var LABELS = {\n        housing: [\"Cheap\", \"Expensive\"],\n        safelimit: [\"Above Limit\", \"Below Limit\"]\n    };\n\n    function getEmbeddedData(name) {\n        return String(Qualtrics.SurveyEngine.getEmbeddedData(name) || \"\").trim();\n    }\n\n    function saveRecord(field, record) {\n        var records;\n        try {\n            records = JSON.parse(getEmbeddedData(field) || \"[]\");\n            if (!Array.isArray(records)) records = [];\n        } catch (_error) {\n            records = [];\n        }\n\n        var existingIndex = records.findIndex(function (item) {\n            return Number(item.instanceId) === Number(record.instanceId);\n        });\n        if (existingIndex >= 0) records[existingIndex] = record;\n        else records.push(record);\n\n        Qualtrics.SurveyEngine.setEmbeddedData(field, JSON.stringify(records));\n    }\n\n    function setNextEnabled(enabled) {\n        if (enabled) question.enableNextButton();\n        else question.disableNextButton();\n    }\n\n    var domain = getEmbeddedData(\"appId\").toLowerCase();\n    if (!CASE_IDS[domain]) domain = \"housing\";\n    Array.prototype.forEach.call(root.querySelectorAll(\"[data-domain]\"), function (item) {\n        item.hidden = item.getAttribute(\"data-domain\") !== domain;\n    });\n\n    var phase = root.getAttribute(\"data-phase\") === \"test\" ? \"test\" : \"training\";\n    var testLabel = Number(root.getAttribute(\"data-test-label\"));\n    var loopIndex = parseInt(\"${lm:\/\/Field\/1}\", 10);\n    if (!Number.isFinite(loopIndex)) loopIndex = 0;\n\n    var caseList = phase === \"training\"\n        ? CASE_IDS[domain].training\n        : CASE_IDS[domain].test[testLabel];\n    var instanceId = caseList && caseList[loopIndex];\n\n    var iframe = document.getElementById(\"cf-case-frame\");\n    var title = document.getElementById(\"cf-case-title\");\n    var status = document.getElementById(\"cf-status\");\n    var answerPanel = document.getElementById(\"cf-training-answer\");\n    var explanation = getEmbeddedData(\"xaiType\") || \"attribution\";\n    var startedAt = Date.now();\n    var prediction = null;\n    var selectedPrediction = null;\n    var latestChanges = [];\n    var latestRawValues = null;\n    var latestFeedback = null;\n\n    if (instanceId === undefined) {\n        status.textContent = \"The Loop & Merge rows are not configured correctly.\";\n        return;\n    }\n\n    function makeIframeUrl(xaiType, showPrediction, simulation) {\n        var base = getEmbeddedData(\"ui_base_url\") ||\n            \"https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html\";\n        var parameters = new URLSearchParams({\n            appId: domain,\n            xaiType: xaiType,\n            split: phase === \"training\" ? \"train\" : \"test\",\n            instanceId: String(instanceId),\n            showPrediction: showPrediction ? \"1\" : \"0\",\n            counterfactualSimulation: simulation ? \"1\" : \"0\"\n        });\n        return base + (base.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + parameters.toString();\n    }\n\n    function trainingRecord() {\n        return {\n            domain: domain,\n            caseNumber: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            selectedPrediction: selectedPrediction,\n            correctPrediction: prediction ? Number(prediction.value) : null,\n            correct: prediction && selectedPrediction !== null\n                ? Number(prediction.value) === selectedPrediction\n                : null,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function testingRecord() {\n        return {\n            domain: domain,\n            direction: LABELS[domain][testLabel] + \" to \" + LABELS[domain][1 - testLabel],\n            caseNumberWithinDirection: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            originalPrediction: prediction,\n            changes: latestChanges,\n            changedRawFeatureValues: latestRawValues,\n            feedback: latestFeedback,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function showTrainingChoices() {\n        if (!answerPanel || !prediction || selectedPrediction !== null) return;\n        answerPanel.innerHTML = \"\";\n        LABELS[domain].forEach(function (label, value) {\n            var button = document.createElement(\"button\");\n            button.type = \"button\";\n            button.className = \"cf-answer-button\";\n            button.textContent = label;\n            button.addEventListener(\"click\", function () {\n                selectedPrediction = value;\n                var correct = Number(prediction.value) === value;\n                status.textContent = correct\n                    ? \"Correct. Review the AI answer and explanation, then continue.\"\n                    : \"Not quite. Review the AI answer and explanation, then continue.\";\n                status.className = correct ? \"cf-status cf-correct\" : \"cf-status cf-incorrect\";\n                Array.prototype.forEach.call(answerPanel.querySelectorAll(\"button\"), function (item) {\n                    item.disabled = true;\n                });\n                saveRecord(\"training_log_json\", trainingRecord());\n                iframe.src = makeIframeUrl(explanation, true, false);\n                setNextEnabled(true);\n            });\n            answerPanel.appendChild(button);\n        });\n        answerPanel.hidden = false;\n        \/\/status.textContent = \"Select your answer below the profile.\";\n    }\n\n    window.addEventListener(\"message\", function (event) {\n        if (event.source !== iframe.contentWindow || !event.data) return;\n        var data = event.data;\n\n        if (data.type === \"counterfactual-ui:iframe-height\") {\n            iframe.style.height = Math.max(320, Math.min(900, Number(data.height) || 0)) + \"px\";\n        } else if (data.type === \"counterfactual-ui:screen-state\") {\n            if (data.screenState && data.screenState.prediction) {\n                prediction = data.screenState.prediction;\n            }\n            if (phase === \"training\") showTrainingChoices();\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-change\") {\n            latestChanges = Array.isArray(data.changes) ? data.changes : [];\n            latestRawValues = data.changedRawFeatureValues || null;\n            if (latestChanges.length > 0) {\n                status.textContent = \"Your changes are saved. You may continue or revise them.\";\n                saveRecord(\"testing_log_json\", testingRecord());\n                setNextEnabled(true);\n            } else {\n                status.textContent = \"Make at least one change before continuing.\";\n                setNextEnabled(false);\n            }\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-feedback\") {\n            latestFeedback = {\n                feedback: data.feedback || null,\n                prediction: data.prediction || null\n            };\n            saveRecord(\"testing_log_json\", testingRecord());\n        }\n    });\n\n    if (phase === \"training\") {\n        title.textContent = \"Training case \" + (loopIndex + 1) + \" of 10\";\n        status.textContent = \"Loading the profile...\";\n        iframe.src = makeIframeUrl(\"none\", false, false);\n    } else {\n        title.textContent = LABELS[domain][testLabel] + \" to \" +\n            LABELS[domain][1 - testLabel] + \": case \" + (loopIndex + 1) + \" of 5\";\n        status.textContent = \"Make at least one change before continuing.\";\n        iframe.src = makeIframeUrl(\"none\", true, true);\n    }\n    setNextEnabled(false);\n\n    var nextButton = document.getElementById(\"NextButton\");\n    if (nextButton) {\n        nextButton.addEventListener(\"click\", function () {\n            saveRecord(\n                phase === \"training\" ? \"training_log_json\" : \"testing_log_json\",\n                phase === \"training\" ? trainingRecord() : testingRecord()\n            );\n        }, true);\n    }\n});","DefaultChoices":false,"DataExportTag":"no_xai_train","QuestionID":"QID12","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Training case Study the profile, then predict the AI output.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q18","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID18"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Housing Developer Session Each of the following five houses is Cheap. For each, a housing develop...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"cf-session-introduction\">\n  <div data-domain=\"housing\" hidden>\n    <h2>Housing Developer Session<\/h2>\n\n    <p>\n      Each of the following five houses is <b>Cheap<\/b>.\n      For each, a <b>housing developer<\/b> wants to modify that house\n      so that it can be classed as <b>Expensive<\/b>.\n      What similar house should the developer design?\n    <\/p>\n  <\/div>\n\n  <div data-domain=\"safelimit\" hidden>\n    <h2>Above Limit to Below Limit<\/h2>\n\n    <p>\n      Each of the following five drivers is <b>Above Limit<\/b>.\n      What changes should they make to be <b>Below Limit<\/b>\n      in the future?\n    <\/p>\n  <\/div>\n<\/div>\n\n<style>\n  .cf-session-introduction {\n    margin-bottom: 22px;\n    padding: 18px 20px;\n    border-left: 5px solid #4387b8;\n    border-radius: 6px;\n    background: #f3f8fc;\n    font-size: 18px;\n    line-height: 1.5;\n  }\n\n  .cf-session-introduction h2 {\n    margin: 0 0 10px;\n    font-size: 24px;\n  }\n\n  .cf-session-introduction p {\n    margin: 0;\n  }\n<\/style>","DefaultChoices":false,"DataExportTag":"Q19","QuestionID":"QID19","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Housing Developer Session Each of the following five houses is Cheap. For each, a housing develop...","DisplayLogic":{"0":{"0":{"LogicType":"LoopAndMerge","LeftOperand":"BL_5aT4RYQul04UaHA,1","RightOperand":"lm:\/\/CurrentLoop","Operator":"EqualTo","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Loop 1: 0<\/span> <span class=\"RightOpDesc\">Current Loop<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \"use strict\";\n\n    var questionContainer = this.getQuestionContainer();\n    var loopIndex = parseInt(\"${lm:\/\/Field\/1}\", 10);\n\n    \/\/ In the ordinary Qualtrics preview, Loop & Merge may not be resolved.\n    if (!Number.isFinite(loopIndex)) {\n        loopIndex = 0;\n    }\n\n    \/*\n     * Hide this entire question after the first Loop & Merge row.\n     *\/\n    if (loopIndex !== 0) {\n        questionContainer.style.display = \"none\";\n        return;\n    }\n\n    var domain = String(\n        Qualtrics.SurveyEngine.getEmbeddedData(\"appId\") || \"housing\"\n    ).toLowerCase();\n\n    if (domain !== \"housing\" && domain !== \"safelimit\") {\n        domain = \"housing\";\n    }\n\n    var domainSections = questionContainer.querySelectorAll(\"[data-domain]\");\n\n    Array.prototype.forEach.call(domainSections, function (section) {\n        section.hidden = section.getAttribute(\"data-domain\") !== domain;\n    });\n});\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Housing Developer Session Each of the following five houses is Cheap. For each, a housing develop...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"cf-session-introduction\">\n  <div data-domain=\"housing\" hidden>\n    <h2>Housing Developer Session<\/h2>\n\n    <p>\n      Each of the following five houses is <b>Cheap<\/b>.\n      For each, a <b>housing developer<\/b> wants to modify that house\n      so that it can be classed as <b>Expensive<\/b>.\n      What similar house should the developer design?\n    <\/p>\n  <\/div>\n\n  <div data-domain=\"safelimit\" hidden>\n    <h2>Above Limit to Below Limit<\/h2>\n\n    <p>\n      Each of the following five drivers is <b>Above Limit<\/b>.\n      What changes should they make to be <b>Below Limit<\/b>\n      in the future?\n    <\/p>\n  <\/div>\n<\/div>\n\n<style>\n  .cf-session-introduction {\n    margin-bottom: 22px;\n    padding: 18px 20px;\n    border-left: 5px solid #4387b8;\n    border-radius: 6px;\n    background: #f3f8fc;\n    font-size: 18px;\n    line-height: 1.5;\n  }\n\n  .cf-session-introduction h2 {\n    margin: 0 0 10px;\n    font-size: 24px;\n  }\n\n  .cf-session-introduction p {\n    margin: 0;\n  }\n<\/style>","DefaultChoices":false,"DataExportTag":"Q20","QuestionID":"QID20","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Housing Developer Session Each of the following five houses is Cheap. For each, a housing develop...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"LoopAndMerge","LeftOperand":"BL_3W1PIk3tbtEX0BE,1","RightOperand":"lm:\/\/CurrentLoop","Operator":"EqualTo","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">Loop 1: 0<\/span> <span class=\"RightOpDesc\">Current Loop<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \"use strict\";\n\n    var questionContainer = this.getQuestionContainer();\n    var loopIndex = parseInt(\"${lm:\/\/Field\/1}\", 10);\n\n    \/\/ In the ordinary Qualtrics preview, Loop & Merge may not be resolved.\n    if (!Number.isFinite(loopIndex)) {\n        loopIndex = 0;\n    }\n\n    \/*\n     * Hide this entire question after the first Loop & Merge row.\n     *\/\n    if (loopIndex !== 0) {\n        questionContainer.style.display = \"none\";\n        return;\n    }\n\n    var domain = String(\n        Qualtrics.SurveyEngine.getEmbeddedData(\"appId\") || \"housing\"\n    ).toLowerCase();\n\n    if (domain !== \"housing\" && domain !== \"safelimit\") {\n        domain = \"housing\";\n    }\n\n    var domainSections = questionContainer.querySelectorAll(\"[data-domain]\");\n\n    Array.prototype.forEach.call(domainSections, function (section) {\n        section.hidden = section.getAttribute(\"data-domain\") !== domain;\n    });\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID266","SecondaryAttribute":"Demographic Questions","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1>Demographic Questions<\/h1>","DefaultChoices":false,"DataExportTag":"Q266","QuestionID":"QID266","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Demographic Questions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID271","SecondaryAttribute":"Basic interface tutorial","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-basic-tutorial-root\" class=\"tutorial-root\">\n  <h1>Basic Interface<\/h1>\n  <div class=\"tutorial-two-column\">\n    <div><section class=\"tutorial-copy\" data-domain=\"housing\">\n  <p>Each house profile is shown using the following interface.<\/p>\n  <ol class=\"tutorial-bullets\">\n    <li>The five <b>attributes<\/b> describing the house.<\/li>\n    <li>The <b>values<\/b> of each attribute.<\/li>\n    <li>Bars indicating how <b>low\/high<\/b> the value is for that attribute (for example, for Living Area, the lowest value is 800 and the highest is 4320, so 1190 is under half of the bar).<\/li>\n    <li>The selected box shows the AI's house-price <b>prediction<\/b>.<\/li>\n  <\/ol>\n<\/section><section class=\"tutorial-copy\" data-domain=\"safelimit\" hidden>\n  <p>Each driver profile is shown using the following interface.<\/p>\n  <ol class=\"tutorial-bullets\">\n    <li>The five <b>attributes<\/b> describing the driver.<\/li>\n    <li>The <b>values<\/b> of each attribute.<\/li>\n    <li>Bars indicating how <b>low\/high<\/b> the value is for that attribute (for example, for Alcohol Units, the lowest value is 1.5 and the highest is 9.5, so 8.5 is well over half of the bar).<\/li>\n    <li>The selected box shows the AI's blood-alcohol-limit <b>prediction<\/b>.<\/li>\n  <\/ol>\n<\/section><\/div>\n    <div class=\"tutorial-preview\"><iframe id=\"cf-basic-tutorial-frame\" title=\"Basic interface example\"><\/iframe><\/div>\n  <\/div>\n<\/div>\n<style>\n  .tutorial-root{font-size:18px;line-height:1.3;max-width:1100px;margin:0 auto}.tutorial-root h1{font-size:30px;margin:0 0 22px}.tutorial-two-column{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(430px,1.25fr);gap:28px;align-items:start}.tutorial-copy p{margin:0 0 18px}.tutorial-bullets{margin:12px 0 0;padding-left:28px}.tutorial-bullets li{margin-bottom:12px}.tutorial-bullets ul{margin-top:8px;padding-left:24px}.tutorial-bullets-compact{margin-top:8px}.tutorial-preview iframe{width:100%;min-height:420px;border:0}.tutorial-red{color:#ea3335}.tutorial-blue{color:#3c88e8}@media(max-width:800px){.tutorial-two-column{grid-template-columns:1fr}.tutorial-preview iframe{min-height:460px}}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q271","QuestionID":"QID271","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Basic interface tutorial","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var ids = {\"housing\":[14693,13350,2968,15034,4666,8187,6557,2898,2864,12633],\"safelimit\":[610,1025,1230,960,239,124,143,131,213,322]};\n  var domain = String(Qualtrics.SurveyEngine.getEmbeddedData('appId') || 'housing').toLowerCase();\n  if (!ids[domain]) domain = 'housing';\n  var root = document.getElementById('cf-basic-tutorial-root');\n  if (!root) return;\n  Array.prototype.forEach.call(root.querySelectorAll('[data-domain]'), function (panel) {\n    panel.hidden = panel.getAttribute('data-domain') !== domain;\n  });\n  var base = String(Qualtrics.SurveyEngine.getEmbeddedData('ui_base_url') || 'https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html');\n  var params = new URLSearchParams({\n    appId: domain,\n    xaiType: 'none',\n    split: 'train',\n    instanceId: String(ids[domain][0]),\n    showPrediction: '1',\n    counterfactualSimulation: '0',\n    tutorialCallouts: 'basic'\n  });\n  var frame = document.getElementById('cf-basic-tutorial-frame');\n  frame.src = base + (base.indexOf('?') >= 0 ? '&' : '?') + params.toString();\n  window.addEventListener('message', function (event) {\n    if (event.source !== frame.contentWindow || !event.data || event.data.type !== 'counterfactual-ui:iframe-height') return;\n    frame.style.height = Math.max(320, Math.min(850, Number(event.data.height) || 0)) + 'px';\n  }, false);\n});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID280","SecondaryAttribute":"HOUSING DOMAIN Understanding an AI house-price classification Imagine that you are reviewing resi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-scenario-root\" class=\"scenario-root\">\n  <section class=\"scenario-card\" data-domain=\"housing\">\n    <p class=\"scenario-eyebrow\">HOUSING DOMAIN<\/p>\n    <h1>Understanding an AI house-price classification<\/h1>\n    <p class=\"scenario-lead\">Imagine that you are reviewing residential property listings. An AI examines five details about each property and classifies the house as <b>Cheap<\/b> or <b>Expensive<\/b>.<\/p>\n    <div class=\"scenario-outcomes\"><div><b>Cheap<\/b><\/div><div><b>Expensive<\/b><\/div><\/div>\n    <h2>Information available to the AI<\/h2>\n    <table class=\"domain-table\"><tr><th>Attribute<\/th><th>Description<\/th><th>Typical range<\/th><\/tr>\n      <tr><td>Living Area<\/td><td>Interior living area<\/td><td>800\u20134,320 sq ft<\/td><\/tr>\n      <tr><td>Bedrooms<\/td><td>Number of bedrooms<\/td><td>2\u20135<\/td><\/tr>\n      <tr><td>Bathrooms<\/td><td>Bathroom equivalent<\/td><td>1\u20133.75<\/td><\/tr>\n      <tr><td>Floors<\/td><td>Number of floors<\/td><td>1\u20132.5<\/td><\/tr>\n      <tr><td>Construction Grade<\/td><td>Overall construction and design quality<\/td><td>6\u201311<\/td><\/tr>\n    <\/table>\n  <\/section>\n  <section class=\"scenario-card\" data-domain=\"safelimit\" hidden>\n    <p class=\"scenario-eyebrow\">DRINK-DRIVING DOMAIN<\/p>\n    <h1>Understanding an AI drink-driving risk classification<\/h1>\n    <p class=\"scenario-lead\">Imagine that you are reviewing driver profiles. An AI uses five details to estimate whether the driver's blood-alcohol level is <b>Above Limit<\/b> or <b>Below Limit<\/b>, using 0.08 as the threshold.<\/p>\n    <div class=\"scenario-outcomes\"><div><b>Above Limit<\/b><\/div><div><b>Below Limit<\/b><\/div><\/div>\n    <h2>Information available to the AI<\/h2>\n    <table class=\"domain-table\"><tr><th>Attribute<\/th><th>Description<\/th><th>Typical range\/options<\/th><\/tr>\n      <tr><td>Alcohol Units<\/td><td>Standard alcohol units consumed<\/td><td>1.496\u20139.5<\/td><\/tr>\n      <tr><td>Weight<\/td><td>Body weight<\/td><td>46.788\u2013102.408 kg<\/td><\/tr>\n      <tr><td>Drinking Duration<\/td><td>Time spent drinking<\/td><td>15\u2013290 minutes<\/td><\/tr>\n      <tr><td>Gender<\/td><td>Gender used by the BAC calculation<\/td><td>Female \/ Male<\/td><\/tr>\n      <tr><td>Stomach Fullness<\/td><td>Whether alcohol was consumed on an empty or full stomach<\/td><td>Empty \/ Full<\/td><\/tr>\n    <\/table>\n  <\/section>\n<\/div>\n<style>\n  .scenario-root{font-size:17px;max-width:980px;margin:0 auto;color:#18222d;line-height:1.55}.scenario-card{border:1px solid #d8e0e8;border-radius:12px;padding:28px;background:#fff;box-shadow:0 4px 18px rgba(36,52,71,.08)}.scenario-card h1{font-size:28px;line-height:1.2;margin:4px 0 14px}.scenario-card h2{font-size:20px;margin:26px 0 10px}.scenario-eyebrow{margin:0;color:#376b91;font-size:13px;font-weight:700;letter-spacing:.08em}.scenario-lead{font-size:18px;margin:0 0 20px}.scenario-outcomes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0 24px}.scenario-outcomes div{display:flex;flex-direction:column;padding:13px;border:1px solid #d8e0e8;border-radius:8px;background:#f8fafc}.scenario-outcomes small{color:#617181}.domain-table{width:100%;border-collapse:collapse}.domain-table th,.domain-table td{padding:10px;border:1px solid #d8dee5;text-align:left}.domain-table th{background:#243447;color:#fff}.scenario-task{margin-top:24px;padding:2px 18px 12px;border-left:4px solid #4387b8;background:#f3f8fc}.scenario-task h2{margin-top:14px}.scenario-task li{margin:7px 0}.scenario-note{margin:18px 0 0;padding:10px 12px;background:#fff6df;border-radius:6px;font-size:14px}@media(max-width:650px){.scenario-card{padding:18px}.scenario-outcomes{grid-template-columns:1fr}.domain-table{font-size:14px}}\n<\/style>","DefaultChoices":false,"DataExportTag":"Q280","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"HOUSING DOMAIN Understanding an AI house-price classification Imagine that you are reviewing resi...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID280","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var domain = String(Qualtrics.SurveyEngine.getEmbeddedData('appId') || 'housing').toLowerCase();\n  var explanation = String(Qualtrics.SurveyEngine.getEmbeddedData('xaiType') || 'attribution').toLowerCase();\n  if (!['attribution', 'counterfactual', 'none'].includes(explanation)) explanation = 'attribution';\n  var root = document.getElementById('cf-scenario-root');\n  if (!root) return;\n  Array.prototype.forEach.call(root.querySelectorAll('[data-domain]'), function (panel) {\n    panel.hidden = panel.getAttribute('data-domain') !== domain;\n  });\n  Array.prototype.forEach.call(root.querySelectorAll('[data-explanation]'), function (item) {\n    item.hidden = item.getAttribute('data-explanation') !== explanation;\n  });\n});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID286","SecondaryAttribute":"Research Study on AI Understanding \u00a0 Welcome! Thank you for your interest in our research study....","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q1","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"Research Study on AI Understanding \u00a0 Welcome! Thank you for your interest in our research study....","QuestionID":"QID286","QuestionJS":"","QuestionText":"<h1>Research Study on AI Understanding<\/h1>\n&nbsp;\n<p>Welcome! Thank you for your interest in our research study. <u>If you recently completed this study, please do not participate again.<\/u> <span style=\"color:#e74c3c;\">Resubmissions may be rejected.<\/span><\/p>\n&nbsp;\nWe are exploring how people can change AI decisions. This study involves:\n<ol>\n\t<li>Consenting to participate.<\/li>\n\t<li>Completing a brief tutorial and screening questions.<\/li>\n\t<li>A training session involving 10 trials.<\/li>\n\t<li>A testing session of 10 trials.<\/li>\n\t<li>Answering demographic questions.<\/li>\n<\/ol>\n\n<p>The survey takes about 30 minutes to complete.<\/p>","QuestionText_Unsafe":"<h1>Research Study on AI Understanding<\/h1>\n&nbsp;\n\n<p>Welcome! Thank you for your interest in our research study. <u>If you recently completed this study, please do not participate again.<\/u> <span style=\"color:#e74c3c;\">Resubmissions may be rejected.<\/span><\/p>\n&nbsp;\n\n<p>We are exploring how people understand AI decisions. The study involves:<\/p>\n\n<ol>\n\t<li>Consenting to participate.<\/li>\n\t<li>Completing a brief tutorial and screening questions.<\/li>\n\t<li>Participating in five sessions:\n\t<ol type=\"a\">\n\t\t<li><strong>1 Training Session:<\/strong> 16 trials with feedback.<\/li>\n\t\t<li><strong>4 Testing Sessions:<\/strong> 20 trials each, no feedback.<\/li>\n\t<\/ol>\n\t<\/li>\n\t<li>Answering methodology and demographic questions.<\/li>\n<\/ol>\n\n<p>The survey takes about 30 minutes to complete.<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID376","SecondaryAttribute":"Testing case This house is Cheap. A housing developer wants to modify it so that it can be classe...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-study-root\" data-phase=\"test\" data-test-label=\"0\" class=\"cf-study-root\">\n  <h2 id=\"cf-case-title\">Testing case<\/h2>\n  \n<p class=\"cf-test-prompt\" data-domain=\"housing\" hidden>\n  This house is <b>Cheap<\/b>. A <b>housing developer<\/b> wants to\n  modify it so that it can be classed as <b>Expensive<\/b>.\n  What minimal changes should the developer make?\n<\/p>\n\n<p class=\"cf-test-prompt\" data-domain=\"safelimit\" hidden>\n  This driver is <b>Above Limit<\/b>. To avoid such an incident in\n  the future, what minimal changes should they make?\n<\/p>\n  <iframe id=\"cf-case-frame\" title=\"Testing profile\" style=\"width:100%;height:650px;border:0\"><\/iframe>\n  <p id=\"cf-status\" class=\"cf-status\" aria-live=\"polite\"><\/p>\n<\/div><style>.cf-study-root{font-size:18px;max-width:1050px;margin:0 auto}.cf-test-prompt{padding:12px 14px;border-left:4px solid #243447;background:#f5f7f9}.cf-status{min-height:1.5em;font-weight:600}<\/style>","QuestionJS":"\/*\n * Shared JavaScript for the training question and both testing questions.\n *\n * Required question HTML:\n *   Training: <div id=\"cf-study-root\" data-phase=\"training\">\n *   Testing:  <div id=\"cf-study-root\" data-phase=\"test\" data-test-label=\"0|1\">\n *\n * Loop & Merge field 1 is 0-9 for training and 0-4 for each testing block.\n *\/\nQualtrics.SurveyEngine.addOnload(function () {\n    \"use strict\";\n\n    var question = this;\n    var root = document.getElementById(\"cf-study-root\");\n    if (!root) return;\n\n    var CASE_IDS = {\n        housing: {\n            training: [14693, 13350, 2968, 15034, 4666, 8187, 6557, 2898, 2864, 12633],\n            test: {\n                0: [3174, 2275, 675, 102, 577],\n                1: [2447, 1751, 553, 172, 2728]\n            }\n        },\n        safelimit: {\n            training: [610, 1025, 1230, 960, 239, 124, 143, 131, 213, 322],\n            test: {\n                0: [87, 203, 106, 143, 300],\n                1: [98, 261, 4, 209, 245]\n            }\n        }\n    };\n    var LABELS = {\n        housing: [\"Cheap\", \"Expensive\"],\n        safelimit: [\"Above Limit\", \"Below Limit\"]\n    };\n\n    function getEmbeddedData(name) {\n        return String(Qualtrics.SurveyEngine.getEmbeddedData(name) || \"\").trim();\n    }\n\n    function saveRecord(field, record) {\n        var records;\n        try {\n            records = JSON.parse(getEmbeddedData(field) || \"[]\");\n            if (!Array.isArray(records)) records = [];\n        } catch (_error) {\n            records = [];\n        }\n\n        var existingIndex = records.findIndex(function (item) {\n            return Number(item.instanceId) === Number(record.instanceId);\n        });\n        if (existingIndex >= 0) records[existingIndex] = record;\n        else records.push(record);\n\n        Qualtrics.SurveyEngine.setEmbeddedData(field, JSON.stringify(records));\n    }\n\n    function setNextEnabled(enabled) {\n        if (enabled) question.enableNextButton();\n        else question.disableNextButton();\n    }\n\n    var domain = getEmbeddedData(\"appId\").toLowerCase();\n    if (!CASE_IDS[domain]) domain = \"housing\";\n    Array.prototype.forEach.call(root.querySelectorAll(\"[data-domain]\"), function (item) {\n        item.hidden = item.getAttribute(\"data-domain\") !== domain;\n    });\n\n    var phase = root.getAttribute(\"data-phase\") === \"test\" ? \"test\" : \"training\";\n    var testLabel = Number(root.getAttribute(\"data-test-label\"));\n    var loopIndex = parseInt(\"${lm:\/\/Field\/1}\", 10);\n    if (!Number.isFinite(loopIndex)) loopIndex = 0;\n\n    var caseList = phase === \"training\"\n        ? CASE_IDS[domain].training\n        : CASE_IDS[domain].test[testLabel];\n    var instanceId = caseList && caseList[loopIndex];\n\n    var iframe = document.getElementById(\"cf-case-frame\");\n    var title = document.getElementById(\"cf-case-title\");\n    var status = document.getElementById(\"cf-status\");\n    var answerPanel = document.getElementById(\"cf-training-answer\");\n    var explanation = getEmbeddedData(\"xaiType\") || \"attribution\";\n    var startedAt = Date.now();\n    var prediction = null;\n    var selectedPrediction = null;\n    var latestChanges = [];\n    var latestRawValues = null;\n    var latestFeedback = null;\n\n    if (instanceId === undefined) {\n        status.textContent = \"The Loop & Merge rows are not configured correctly.\";\n        return;\n    }\n\n    function makeIframeUrl(xaiType, showPrediction, simulation) {\n        var base = getEmbeddedData(\"ui_base_url\") ||\n            \"https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html\";\n        var parameters = new URLSearchParams({\n            appId: domain,\n            xaiType: xaiType,\n            split: phase === \"training\" ? \"train\" : \"test\",\n            instanceId: String(instanceId),\n            showPrediction: showPrediction ? \"1\" : \"0\",\n            counterfactualSimulation: simulation ? \"1\" : \"0\"\n        });\n        return base + (base.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + parameters.toString();\n    }\n\n    function trainingRecord() {\n        return {\n            domain: domain,\n            caseNumber: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            selectedPrediction: selectedPrediction,\n            correctPrediction: prediction ? Number(prediction.value) : null,\n            correct: prediction && selectedPrediction !== null\n                ? Number(prediction.value) === selectedPrediction\n                : null,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function testingRecord() {\n        return {\n            domain: domain,\n            direction: LABELS[domain][testLabel] + \" to \" + LABELS[domain][1 - testLabel],\n            caseNumberWithinDirection: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            originalPrediction: prediction,\n            changes: latestChanges,\n            changedRawFeatureValues: latestRawValues,\n            feedback: latestFeedback,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function showTrainingChoices() {\n        if (!answerPanel || !prediction || selectedPrediction !== null) return;\n        answerPanel.innerHTML = \"\";\n        LABELS[domain].forEach(function (label, value) {\n            var button = document.createElement(\"button\");\n            button.type = \"button\";\n            button.className = \"cf-answer-button\";\n            button.textContent = label;\n            button.addEventListener(\"click\", function () {\n                selectedPrediction = value;\n                var correct = Number(prediction.value) === value;\n                status.textContent = correct\n                    ? \"Correct. Review the AI answer and explanation, then continue.\"\n                    : \"Not quite. Review the AI answer and explanation, then continue.\";\n                status.className = correct ? \"cf-status cf-correct\" : \"cf-status cf-incorrect\";\n                Array.prototype.forEach.call(answerPanel.querySelectorAll(\"button\"), function (item) {\n                    item.disabled = true;\n                });\n                saveRecord(\"training_log_json\", trainingRecord());\n                iframe.src = makeIframeUrl(explanation, true, false);\n                setNextEnabled(true);\n            });\n            answerPanel.appendChild(button);\n        });\n        answerPanel.hidden = false;\n        status.textContent = \"Select your answer below the profile.\";\n    }\n\n    window.addEventListener(\"message\", function (event) {\n        if (event.source !== iframe.contentWindow || !event.data) return;\n        var data = event.data;\n\n        if (data.type === \"counterfactual-ui:iframe-height\") {\n            iframe.style.height = Math.max(320, Math.min(900, Number(data.height) || 0)) + \"px\";\n        } else if (data.type === \"counterfactual-ui:screen-state\") {\n            if (data.screenState && data.screenState.prediction) {\n                prediction = data.screenState.prediction;\n            }\n            if (phase === \"training\") showTrainingChoices();\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-change\") {\n            latestChanges = Array.isArray(data.changes) ? data.changes : [];\n            latestRawValues = data.changedRawFeatureValues || null;\n            if (latestChanges.length > 0) {\n                status.textContent = \"Your changes are saved. You may continue or revise them.\";\n                saveRecord(\"testing_log_json\", testingRecord());\n                setNextEnabled(true);\n            } else {\n                status.textContent = \"Make at least one change before continuing.\";\n                setNextEnabled(false);\n            }\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-feedback\") {\n            latestFeedback = {\n                feedback: data.feedback || null,\n                prediction: data.prediction || null\n            };\n            saveRecord(\"testing_log_json\", testingRecord());\n        }\n    });\n\n    if (phase === \"training\") {\n        title.textContent = \"Training case \" + (loopIndex + 1) + \" of 10\";\n        status.textContent = \"Loading the profile...\";\n        iframe.src = makeIframeUrl(\"none\", false, false);\n    } else {\n        title.textContent = LABELS[domain][testLabel] + \" to \" +\n            LABELS[domain][1 - testLabel] + \": case \" + (loopIndex + 1) + \" of 5\";\n        status.textContent = \"Make at least one change before continuing.\";\n        iframe.src = makeIframeUrl(\"none\", true, true);\n    }\n    setNextEnabled(false);\n\n    var nextButton = document.getElementById(\"NextButton\");\n    if (nextButton) {\n        nextButton.addEventListener(\"click\", function () {\n            saveRecord(\n                phase === \"training\" ? \"training_log_json\" : \"testing_log_json\",\n                phase === \"training\" ? trainingRecord() : testingRecord()\n            );\n        }, true);\n    }\n});\n","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Testing case This house is Cheap. A housing developer wants to modify it so that it can be classe...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<div class=\"content\" style=\"font-size: 20px;\">\n\t<h3 id=\"caseTitle\">Case #<span id=\"caseNum\"><\/span>: No Explanation<\/h3>\n    &nbsp;\n\n    <p>Study this case that the AI system predicts on<\/p>\n    &nbsp;\n\n    <div style=\"display: flex; justify-content: center; align-items: center;\">\n        <iframe id=\"Iframe\" src=\"\" style=\"height:330px; border: none; width:100%\"><\/iframe>\n    <\/div>\n<\/div>\n","DataExportTag":"TestDirection0","QuestionID":"QID376"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID379","SecondaryAttribute":"Testing case This house is Expensive. A buyer wants this house but wants it cheap. What minimal c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-study-root\" data-phase=\"test\" data-test-label=\"1\" class=\"cf-study-root\">\n  <h2 id=\"cf-case-title\">Testing case<\/h2>\n  \n<p class=\"cf-test-prompt\" data-domain=\"housing\" hidden>\n  This house is <b>Expensive<\/b>. A <b>buyer<\/b> wants this house\n  but wants it cheap. What minimal changes would describe a similar\n  <b>Cheap<\/b> house?\n<\/p>\n\n<p class=\"cf-test-prompt\" data-domain=\"safelimit\" hidden>\n  This driver is <b>Below Limit<\/b>. To avoid being found\n  <b>Above Limit<\/b> in the future, what minimal changes should\n  they avoid?\n<\/p>\n  <iframe id=\"cf-case-frame\" title=\"Testing profile\" style=\"width:100%;height:650px;border:0\"><\/iframe>\n  <p id=\"cf-status\" class=\"cf-status\" aria-live=\"polite\"><\/p>\n<\/div><style>.cf-study-root{font-size:18px;max-width:1050px;margin:0 auto}.cf-test-prompt{padding:12px 14px;border-left:4px solid #243447;background:#f5f7f9}.cf-status{min-height:1.5em;font-weight:600}<\/style>","QuestionJS":"\/*\n * Shared JavaScript for the training question and both testing questions.\n *\n * Required question HTML:\n *   Training: <div id=\"cf-study-root\" data-phase=\"training\">\n *   Testing:  <div id=\"cf-study-root\" data-phase=\"test\" data-test-label=\"0|1\">\n *\n * Loop & Merge field 1 is 0-9 for training and 0-4 for each testing block.\n *\/\nQualtrics.SurveyEngine.addOnload(function () {\n    \"use strict\";\n\n    var question = this;\n    var root = document.getElementById(\"cf-study-root\");\n    if (!root) return;\n\n    var CASE_IDS = {\n        housing: {\n            training: [14693, 13350, 2968, 15034, 4666, 8187, 6557, 2898, 2864, 12633],\n            test: {\n                0: [3174, 2275, 675, 102, 577],\n                1: [2447, 1751, 553, 172, 2728]\n            }\n        },\n        safelimit: {\n            training: [610, 1025, 1230, 960, 239, 124, 143, 131, 213, 322],\n            test: {\n                0: [87, 203, 106, 143, 300],\n                1: [98, 261, 4, 209, 245]\n            }\n        }\n    };\n    var LABELS = {\n        housing: [\"Cheap\", \"Expensive\"],\n        safelimit: [\"Above Limit\", \"Below Limit\"]\n    };\n\n    function getEmbeddedData(name) {\n        return String(Qualtrics.SurveyEngine.getEmbeddedData(name) || \"\").trim();\n    }\n\n    function saveRecord(field, record) {\n        var records;\n        try {\n            records = JSON.parse(getEmbeddedData(field) || \"[]\");\n            if (!Array.isArray(records)) records = [];\n        } catch (_error) {\n            records = [];\n        }\n\n        var existingIndex = records.findIndex(function (item) {\n            return Number(item.instanceId) === Number(record.instanceId);\n        });\n        if (existingIndex >= 0) records[existingIndex] = record;\n        else records.push(record);\n\n        Qualtrics.SurveyEngine.setEmbeddedData(field, JSON.stringify(records));\n    }\n\n    function setNextEnabled(enabled) {\n        if (enabled) question.enableNextButton();\n        else question.disableNextButton();\n    }\n\n    var domain = getEmbeddedData(\"appId\").toLowerCase();\n    if (!CASE_IDS[domain]) domain = \"housing\";\n    Array.prototype.forEach.call(root.querySelectorAll(\"[data-domain]\"), function (item) {\n        item.hidden = item.getAttribute(\"data-domain\") !== domain;\n    });\n\n    var phase = root.getAttribute(\"data-phase\") === \"test\" ? \"test\" : \"training\";\n    var testLabel = Number(root.getAttribute(\"data-test-label\"));\n    var loopIndex = parseInt(\"${lm:\/\/Field\/1}\", 10);\n    if (!Number.isFinite(loopIndex)) loopIndex = 0;\n\n    var caseList = phase === \"training\"\n        ? CASE_IDS[domain].training\n        : CASE_IDS[domain].test[testLabel];\n    var instanceId = caseList && caseList[loopIndex];\n\n    var iframe = document.getElementById(\"cf-case-frame\");\n    var title = document.getElementById(\"cf-case-title\");\n    var status = document.getElementById(\"cf-status\");\n    var answerPanel = document.getElementById(\"cf-training-answer\");\n    var explanation = getEmbeddedData(\"xaiType\") || \"attribution\";\n    var startedAt = Date.now();\n    var prediction = null;\n    var selectedPrediction = null;\n    var latestChanges = [];\n    var latestRawValues = null;\n    var latestFeedback = null;\n\n    if (instanceId === undefined) {\n        status.textContent = \"The Loop & Merge rows are not configured correctly.\";\n        return;\n    }\n\n    function makeIframeUrl(xaiType, showPrediction, simulation) {\n        var base = getEmbeddedData(\"ui_base_url\") ||\n            \"https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html\";\n        var parameters = new URLSearchParams({\n            appId: domain,\n            xaiType: xaiType,\n            split: phase === \"training\" ? \"train\" : \"test\",\n            instanceId: String(instanceId),\n            showPrediction: showPrediction ? \"1\" : \"0\",\n            counterfactualSimulation: simulation ? \"1\" : \"0\"\n        });\n        return base + (base.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + parameters.toString();\n    }\n\n    function trainingRecord() {\n        return {\n            domain: domain,\n            caseNumber: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            selectedPrediction: selectedPrediction,\n            correctPrediction: prediction ? Number(prediction.value) : null,\n            correct: prediction && selectedPrediction !== null\n                ? Number(prediction.value) === selectedPrediction\n                : null,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function testingRecord() {\n        return {\n            domain: domain,\n            direction: LABELS[domain][testLabel] + \" to \" + LABELS[domain][1 - testLabel],\n            caseNumberWithinDirection: loopIndex + 1,\n            instanceId: instanceId,\n            explanation: explanation,\n            originalPrediction: prediction,\n            changes: latestChanges,\n            changedRawFeatureValues: latestRawValues,\n            feedback: latestFeedback,\n            responseMs: Date.now() - startedAt\n        };\n    }\n\n    function showTrainingChoices() {\n        if (!answerPanel || !prediction || selectedPrediction !== null) return;\n        answerPanel.innerHTML = \"\";\n        LABELS[domain].forEach(function (label, value) {\n            var button = document.createElement(\"button\");\n            button.type = \"button\";\n            button.className = \"cf-answer-button\";\n            button.textContent = label;\n            button.addEventListener(\"click\", function () {\n                selectedPrediction = value;\n                var correct = Number(prediction.value) === value;\n                status.textContent = correct\n                    ? \"Correct. Review the AI answer and explanation, then continue.\"\n                    : \"Not quite. Review the AI answer and explanation, then continue.\";\n                status.className = correct ? \"cf-status cf-correct\" : \"cf-status cf-incorrect\";\n                Array.prototype.forEach.call(answerPanel.querySelectorAll(\"button\"), function (item) {\n                    item.disabled = true;\n                });\n                saveRecord(\"training_log_json\", trainingRecord());\n                iframe.src = makeIframeUrl(explanation, true, false);\n                setNextEnabled(true);\n            });\n            answerPanel.appendChild(button);\n        });\n        answerPanel.hidden = false;\n        status.textContent = \"Select your answer below the profile.\";\n    }\n\n    window.addEventListener(\"message\", function (event) {\n        if (event.source !== iframe.contentWindow || !event.data) return;\n        var data = event.data;\n\n        if (data.type === \"counterfactual-ui:iframe-height\") {\n            iframe.style.height = Math.max(320, Math.min(900, Number(data.height) || 0)) + \"px\";\n        } else if (data.type === \"counterfactual-ui:screen-state\") {\n            if (data.screenState && data.screenState.prediction) {\n                prediction = data.screenState.prediction;\n            }\n            if (phase === \"training\") showTrainingChoices();\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-change\") {\n            latestChanges = Array.isArray(data.changes) ? data.changes : [];\n            latestRawValues = data.changedRawFeatureValues || null;\n            if (latestChanges.length > 0) {\n                status.textContent = \"Your changes are saved. You may continue or revise them.\";\n                saveRecord(\"testing_log_json\", testingRecord());\n                setNextEnabled(true);\n            } else {\n                status.textContent = \"Make at least one change before continuing.\";\n                setNextEnabled(false);\n            }\n        } else if (phase === \"test\" && data.type === \"counterfactual-ui:simulation-feedback\") {\n            latestFeedback = {\n                feedback: data.feedback || null,\n                prediction: data.prediction || null\n            };\n            saveRecord(\"testing_log_json\", testingRecord());\n        }\n    });\n\n    if (phase === \"training\") {\n        title.textContent = \"Training case \" + (loopIndex + 1) + \" of 10\";\n        status.textContent = \"Loading the profile...\";\n        iframe.src = makeIframeUrl(\"none\", false, false);\n    } else {\n        title.textContent = LABELS[domain][testLabel] + \" to \" +\n            LABELS[domain][1 - testLabel] + \": case \" + (loopIndex + 1) + \" of 5\";\n        status.textContent = \"Make at least one change before continuing.\";\n        iframe.src = makeIframeUrl(\"none\", true, true);\n    }\n    setNextEnabled(false);\n\n    var nextButton = document.getElementById(\"NextButton\");\n    if (nextButton) {\n        nextButton.addEventListener(\"click\", function () {\n            saveRecord(\n                phase === \"training\" ? \"training_log_json\" : \"testing_log_json\",\n                phase === \"training\" ? trainingRecord() : testingRecord()\n            );\n        }, true);\n    }\n});\n","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Testing case This house is Expensive. A buyer wants this house but wants it cheap. What minimal c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<div class=\"content\" style=\"font-size: 20px;\">\n\t<h3 id=\"caseTitle\">Case #<span id=\"caseNum\"><\/span>: No Explanation<\/h3>\n    &nbsp;\n\n    <p>Study this case that the AI system predicts on<\/p>\n    &nbsp;\n\n    <div style=\"display: flex; justify-content: center; align-items: center;\">\n        <iframe id=\"Iframe\" src=\"\" style=\"height:330px; border: none; width:100%\"><\/iframe>\n    <\/div>\n<\/div>\n","DataExportTag":"TestDirection1","QuestionID":"QID379"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID390","SecondaryAttribute":"Testing","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1>Testing<\/h1>\n<br>\n<p id=\"cf-test-intro-copy\"><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Testing","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var domain = String(Qualtrics.SurveyEngine.getEmbeddedData('appId') || 'housing').toLowerCase();\n  var explanation = String(Qualtrics.SurveyEngine.getEmbeddedData('xaiType') || 'attribution').toLowerCase();\n  var text = document.getElementById('cf-test-intro-copy');\n  if (!text) return;\n  if ('test' === 'training') {\n    var review = explanation === 'attribution'\n      ? 'review the correct answer and the feature-influence explanation'\n      : explanation === 'counterfactual'\n      ? 'review the correct answer and the counter-example explanation'\n      : 'review the correct answer';\n    text.innerHTML = domain === 'safelimit'\n      ? 'You will see <b>10 driver profiles<\/b>. Predict Above Limit or Below Limit, then ' + review + '.'\n      : 'You will see <b>10 house profiles<\/b>. Predict Cheap or Expensive, then ' + review + '.';\n  } else {\n    text.innerHTML = domain === 'safelimit'\n      ? 'You will complete two sessions with five-profiles each. You will have to change the AI predictions from Above Limit to Below Limit or vice versa.'\n      : 'You will complete two sessions with five-profiles each. You will have to change the AI predictions from Above Limit to Below Limit or vice versa.';\n  }\n});\nQualtrics.SurveyEngine.addOnReady(function () {});\nQualtrics.SurveyEngine.addOnUnload(function () {});","QuestionText_Unsafe":"<div style=\"font-size: 20px;\">\n\t<h1>Session 1<\/h1>\n\t<br>\n    <p>Your main task is to understand how the AI predicts \n        <span style=\"color:#e74c3c;\">${e:\/\/Field\/option1}<\/span> or \n        <span style=\"color:#3498db;\">${e:\/\/Field\/option2}<\/span>.\n    <\/p>\n\t\n    <p>The session has two parts:<\/p>\n\t<br>\n    <b>Part 1: Estimate AI decision (5 trials)<\/b>\n    <ol>\n        <li>Predict the AI's decision.<\/li>\n        <li>Predict again after seeing <b>an explanation<\/b> provided.<\/li>\n        <li>Receive feedback on the AI's actual prediction.<\/li>\n    <\/ol>\n\n    <b>Part 2: Change AI decision (3 trials)<\/b>\n    <ol>\n        <li>Modify details of the current case to try changing the AI's prediction.<\/li>\n        <li>Modify the case again after reviewing <b>an explanation<\/b> provided to you.<\/li>\n    <\/ol>\n<\/div>","DataExportTag":"Q390","QuestionID":"QID390"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Consent \u00adForm Title: Understanding of AI decisions Principle Investigator: Associate Professor Br..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1 style=\"margin-top:24px; margin-bottom:8px\"><span style=\"color:#3498db;\"><strong><span style=\"font-size:26px;\">Consent \u00adForm<\/span><\/strong><\/span><\/h1>\n<br>\n<strong>Title: Understanding of AI decisions<\/strong><br>\n<br>\n<strong>Principle Investigator:<\/strong><br>\nAssociate Professor Brian Lim<br>\nOrganisation: School of Computing, National University of Singapore<br>\nEmail: brianlim@comp.nus.edu.sg<br>\n<br>\n<strong>Before participating in this research, please read the following items.<\/strong><br>\n<br>\n<strong>Participation is voluntary.<\/strong><br>\nYou must be at least 21 years of age to participate. It is your choice whether or not to participate in this research. If you choose to participate, you may change your mind and leave the study at any time. Refusing to participate or choosing to stop your participation will not result in any penalties.<br>\n<br>\n<strong>What is the purpose of this research?<\/strong><br>\nThis study aims to investigate people\u2019s ability in understanding AI decisions.<br>\n<br>\n<strong>How long will I take part in this research?<\/strong><br>\nAbout 30 mins.<br>\n<br>\n<strong>What is the approximate number of research participants involved?<\/strong><br>300.<br>\n<br>\n<strong>What will be done if I take part in this research?<\/strong><br>\nYou will study a tutorial and take a screening test to qualify for the main study. Then you will go through 3 sessions for the main study. Subsequently, you will answer some demographic questions<br>\n<br>\n<strong>What are the risks and possible discomforts?<\/strong><br>\nNone.<br>\n<br>\n<strong>Are there any benefits from being in this research study?<\/strong><br>\nThere is no direct benefit to you by participating in this research study. The public, researchers with interests in human understanding of AI decisions should benefit from the results of this study.<br>\n<br>\n<strong>Will I be compensated for participating in this research?<\/strong><br>\nYes, see the survey description.<br>\n<br>\n<strong>If I take part in this research, how will my privacy be protected? What happens to the information you collect?<\/strong><br>\nWe will collect your responses on secure servers and will not record any personally identifying information. You will be assigned a unique participant ID. Your responses, linked only to this ID, will be included in a public, open-access dataset so other researchers can reproduce and extend this work. No personal details will be shared.\n<br>\nResearch results will be reported in aggregate, and data will be stored in line with the University\u2019s Research Data Management Policy.<br>\n<br>\n<strong>Can I refuse to participate in this research?<\/strong><br>\nYes, you can. Your decision to participate in this research is voluntary. You can also withdraw from the research at any time without giving any reasons.<br>\n<br>\n<strong>If I have any questions, concerns or complaints about this research study, who can I talk to?<\/strong><br>\nThe researcher for this study is Louth Bin Rawshan. If you have questions, concerns, or complaints, or think the research has hurt you, please feel free to contact Louth at <a href=\"mailto:louth@comp.nus.edu.sg\">louth@comp.nus.edu.sg<\/a>.\n<br><br>\n<div>By clicking the \"I Accept\" button, you acknowledge&nbsp;<strong>ALL of the following<\/strong>:<\/div>\n\n<div>1. I am at least 21 years of age,<\/div>\n\n<div>2. I agree to take part in the aforementioned research,<\/div>\n\n<div>3. I will not have any financial benefits that result from the commercial development of&nbsp;this research, and<\/div>\n\n<div>4. I consent to have the coded data made available for future research.<\/div>","DefaultChoices":false,"DataExportTag":"Q2","QuestionID":"QID5","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consent \u00adForm Title: Understanding of AI decisions Principle Investigator: Associate Professor Br...","Choices":{"1":{"Display":"I agree"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"Gender","TertiaryAttribute":null,"Payload":{"QuestionText":"Gender","DefaultChoices":false,"DataExportTag":"Q70","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gender","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Other (please specify)","TextEntry":"true"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Age","TertiaryAttribute":null,"Payload":{"QuestionText":"Age","DefaultChoices":false,"DataExportTag":"Q71","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Age","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID71"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID72","SecondaryAttribute":"What is the highest degree or level of education you have completed?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the highest degree or level of education you have completed?","DataExportTag":"Q72","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the highest degree or level of education you have completed?","Choices":{"1":{"Display":"a) Less than high school degree"},"2":{"Display":"b) High school degree or equivalent (e.g., GED)"},"3":{"Display":"c) Some college but no degree"},"4":{"Display":"d) Associate degree"},"5":{"Display":"e) Bachelor degree"},"6":{"Display":"f) Graduate degree"}},"ChoiceOrder":["1","2","3","4","5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID72"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID73","SecondaryAttribute":"What is your ethnicity?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your ethnicity?","DefaultChoices":false,"DataExportTag":"Q73","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your ethnicity?","Choices":{"1":{"Display":"a) White"},"2":{"Display":"b) Hispanic or Latino"},"3":{"Display":"c) Black or African American"},"4":{"Display":"d) Native American or American Indian"},"5":{"Display":"e) Asian or Pacific Islander"},"6":{"Display":"f) Other (please specify)","TextEntry":"true"}},"ChoiceOrder":["1","2","3","4","5","6"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID73"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID74","SecondaryAttribute":"What is your current employment status?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your current employment status?","DataExportTag":"Q74","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your current employment status?","Choices":{"1":{"Display":"Employed"},"2":{"Display":"Not employed"},"3":{"Display":"Student"},"4":{"Display":"Homemaker"},"5":{"Display":"Retired"},"6":{"Display":"Disabled"},"7":{"Display":"Other (please specify)","TextEntry":"true"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID74"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"What industry or field are you currently working\/studying in (e.g., healthcare, computing, educat...","TertiaryAttribute":null,"Payload":{"QuestionText":"What industry or field are you currently working\/studying in (e.g., healthcare, computing, education)?<br>","DefaultChoices":false,"DataExportTag":"Q75","QuestionID":"QID75","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What industry or field are you currently working\/studying in (e.g., healthcare, computing, educat...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":26,"NextAnswerId":4,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Explanation interface tutorial","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"cf-explanation-tutorial-root\" class=\"tutorial-root\">\n  <h1>AI Explanation<\/h1>\n  <div class=\"tutorial-two-column\">\n    <div><section class=\"tutorial-copy\" data-domain=\"housing\" data-explanation=\"attribution\" data-instance-id=\"14693\">\n  <p>To learn how the AI predicts, you will see an explanation for the AI's price prediction. This explanation shows the <b>two most important attributes<\/b> for that profile.<\/p>\n<p>The numbered explanation interface shows:<\/p>\n<ol class=\"tutorial-bullets tutorial-bullets-compact\">\n  <li>The influence of the two most important attributes (Bedrooms, <span class=\"tutorial-blue\">+50%<\/span> and Living Area, <span class=\"tutorial-red\">-50%<\/span>). The higher the number, the stronger the influence.\n    <ul><li><span class=\"tutorial-red\">Red bars<\/span> contribute towards a <b>cheap<\/b> decision.<\/li><li><span class=\"tutorial-blue\">Blue bars<\/span> contribute towards a <b>expensive<\/b> decision.<\/li><\/ul>\n  <\/li>\n  <li>A sentence describing the price prediction and the influences.<\/li>\n<\/ol>\n<\/section><section class=\"tutorial-copy\" data-domain=\"housing\" data-explanation=\"counterfactual\" data-instance-id=\"2968\" hidden>\n  <p>To learn how the AI predicts, you will see an explanation for the AI's price prediction. This explanation shows a <b>counter-example<\/b>, where <b>two attributes are changed<\/b> to alter the price prediction.<\/p>\n<p>The numbered explanation interface shows:<\/p>\n<ol class=\"tutorial-bullets tutorial-bullets-compact\">\n  <li>The changes in the two attributes in the counter-example.<ul><li><span class=\"tutorial-red\">Living Area<\/span> decreases from 1090 to 1089.<\/li><li><span class=\"tutorial-blue\">Floors<\/span> increases from 1.5 to 2.<\/li><\/ul><\/li>\n  <li>A sentence describing the price prediction and the effect of the changes.<\/li>\n<\/ol>\n<\/section><section class=\"tutorial-copy\" data-domain=\"safelimit\" data-explanation=\"attribution\" data-instance-id=\"960\" hidden>\n  <p>To learn how the AI predicts, you will see an explanation for the AI's blood-alcohol-limit prediction. This explanation shows the <b>two most important attributes<\/b> for that profile.<\/p>\n<p>The numbered explanation interface shows:<\/p>\n<ol class=\"tutorial-bullets tutorial-bullets-compact\">\n  <li>The influence of the two most important attributes (Alcohol Units, <span class=\"tutorial-blue\">+86%<\/span> and Stomach Fullness, <span class=\"tutorial-red\">-14%<\/span>). The higher the number, the stronger the influence.\n    <ul><li><span class=\"tutorial-red\">Red bars<\/span> contribute towards a <b>above limit<\/b> decision.<\/li><li><span class=\"tutorial-blue\">Blue bars<\/span> contribute towards a <b>below limit<\/b> decision.<\/li><\/ul>\n  <\/li>\n  <li>A sentence describing the blood-alcohol-limit prediction and the influences.<\/li>\n<\/ol>\n<\/section><section class=\"tutorial-copy\" data-domain=\"safelimit\" data-explanation=\"counterfactual\" data-instance-id=\"610\" hidden>\n  <p>To learn how the AI predicts, you will see an explanation for the AI's blood-alcohol-limit prediction. This explanation shows a <b>counter-example<\/b>, where <b>two attributes are changed<\/b> to alter the blood-alcohol-limit prediction.<\/p>\n<p>The numbered explanation interface shows:<\/p>\n<ol class=\"tutorial-bullets tutorial-bullets-compact\">\n  <li>The changes in the two attributes in the counter-example.<ul><li><span class=\"tutorial-red\">Alcohol Units<\/span> decreases from 8.5 to 5.4.<\/li><li><span class=\"tutorial-blue\">Weight<\/span> increases from 67.1 to 71.9.<\/li><\/ul><\/li>\n  <li>A sentence describing the blood-alcohol-limit prediction and the effect of the changes.<\/li>\n<\/ol>\n<\/section><\/div>\n    <div class=\"tutorial-preview\"><iframe id=\"cf-explanation-tutorial-frame\" title=\"Explanation interface example\"><\/iframe><\/div>\n  <\/div>\n<\/div>\n<style>\n  .tutorial-root{font-size:18px;line-height:1.3;max-width:1100px;margin:0 auto}.tutorial-root h1{font-size:30px;margin:0 0 22px}.tutorial-two-column{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(430px,1.25fr);gap:28px;align-items:start}.tutorial-copy p{margin:0 0 18px}.tutorial-bullets{margin:12px 0 0;padding-left:28px}.tutorial-bullets li{margin-bottom:12px}.tutorial-bullets ul{margin-top:8px;padding-left:24px}.tutorial-bullets-compact{margin-top:8px}.tutorial-preview iframe{width:100%;min-height:420px;border:0}.tutorial-red{color:#ea3335}.tutorial-blue{color:#3c88e8}@media(max-width:800px){.tutorial-two-column{grid-template-columns:1fr}.tutorial-preview iframe{min-height:460px}}\n<\/style>","DefaultChoices":false,"DataExportTag":"ExplanationTutorial","QuestionID":"QID9","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Explanation interface tutorial","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var root = document.getElementById('cf-explanation-tutorial-root');\n  if (!root) return;\n  var domain = String(Qualtrics.SurveyEngine.getEmbeddedData('appId') || 'housing').toLowerCase();\n  var explanation = String(Qualtrics.SurveyEngine.getEmbeddedData('xaiType') || 'attribution').toLowerCase();\n  var ids = {\"housing\":{\"attribution\":14693,\"counterfactual\":2968},\"safelimit\":{\"attribution\":960,\"counterfactual\":610}};\n  if (!ids[domain]) domain = 'housing';\n  if (!['attribution', 'counterfactual'].includes(explanation)) {\n    this.getQuestionContainer().style.display = 'none';\n    return;\n  }\n  Array.prototype.forEach.call(root.querySelectorAll('[data-domain][data-explanation]'), function (panel) {\n    panel.hidden = panel.getAttribute('data-domain') !== domain ||\n      panel.getAttribute('data-explanation') !== explanation;\n  });\n  var base = String(Qualtrics.SurveyEngine.getEmbeddedData('ui_base_url') || 'https:\/\/louth-bin.github.io\/attribution-counterfactual-ui\/iframe.html');\n  var params = new URLSearchParams({\n    appId: domain,\n    xaiType: explanation,\n    split: 'train',\n    instanceId: String(ids[domain][explanation]),\n    showPrediction: '1',\n    counterfactualSimulation: '0',\n    tutorialCallouts: 'explanation'\n  });\n  var frame = document.getElementById('cf-explanation-tutorial-frame');\n  frame.src = base + (base.indexOf('?') >= 0 ? '&' : '?') + params.toString();\n  window.addEventListener('message', function (event) {\n    if (event.source !== frame.contentWindow || !event.data || event.data.type !== 'counterfactual-ui:iframe-height') return;\n    frame.style.height = Math.max(360, Math.min(900, Number(event.data.height) || 0)) + 'px';\n  }, false);\n});"}},{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}