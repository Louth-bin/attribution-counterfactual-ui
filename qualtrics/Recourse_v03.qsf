{"SurveyEntry":{"SurveyID":"SV_0SScpCX79Uqev0W","SurveyName":"Recourse v0.3","SurveyDescription":"Qualtrics-hosted study using the basic counterfactual UI frame; 10 fixed training and 10 fixed test ","SurveyOwnerID":"UR_0OHrP4h9ze8LdMa","SurveyBrandID":"nus","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_57nH6bcReVak27c","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-08-11 22:01:28","CreatorID":"UR_0OHrP4h9ze8LdMa","LastModified":"2026-08-11 22:52:02","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_0SScpCX79Uqev0W","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","SubType":"","Description":"Introduction","ID":"BL_5cCx0dF9dBRyR4W","BlockElements":[{"Type":"Question","QuestionID":"QID286"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},{"Type":"Trash","SubType":"","Description":"Trash \/ Unused Questions","ID":"BL_0j1M5799dsLpL5c","BlockElements":[{"Type":"Question","QuestionID":"QID18"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Collapsed"}},{"Type":"Standard","SubType":"","Description":"Consent","ID":"BL_bOEr2QTL2wESbqu","BlockElements":[{"Type":"Question","QuestionID":"QID5"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},{"Type":"Standard","SubType":"","Description":"Domain and Interface Tutorials","ID":"BL_eXxzjmRQ8gb7FGu","BlockElements":[{"Type":"Question","QuestionID":"QID280"},{"Type":"Question","QuestionID":"QID271"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID9"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},{"Type":"Standard","SubType":"","Description":"Training Introduction","ID":"BL_aUXleLP5D