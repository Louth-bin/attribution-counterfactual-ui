Names Default To Here(1);

rootPath = "C:/Users/Louth/Desktop/counterfactual/attribution-counterfactual-ui/";
referencePath = Convert File Path(rootPath || "qualtrics/qualtrics_results_v1.5.jmp", Windows);
sourcePath = Convert File Path(rootPath || "qualtrics/qualtrics_results_v2.0.csv", Windows);
outputPath = Convert File Path(rootPath || "qualtrics/qualtrics_results_v2.0.jmp", Windows);
reportPath = Convert File Path(rootPath || "qualtrics/v2.0_results_jmp_validation.txt", Windows);

dt = Open(referencePath, Invisible);
source = Open(sourcePath, Invisible);
originalScripts = dt << Get Table Script Names;
modelColumnNames = {
	"cognitive model v0.1 family",
	"explanation reliance (η)",
	"global relevance reliance (α)",
	"additive change margin (ρ)",
	"exemplar locality (λ)",
	"remembered-change reliance (β)",
	"age treated as actionable (0/1)"
};
For(columnIndex = 1, columnIndex <= N Items(modelColumnNames), columnIndex++,
	columnName = modelColumnNames[columnIndex];
	If(Contains(dt << Get Column Names("String"), columnName) == 0,
		If(columnName == "cognitive model v0.1 family",
			dt << New Column(columnName, Character, Nominal),
			dt << New Column(columnName, Numeric, Continuous)
		)
	)
);
targetNames = dt << Get Column Names("String");
sourceNames = source << Get Column Names("String");
schemaMatch = N Items(targetNames) == N Items(sourceNames) + 2
	& Contains(targetNames, "participant level correct direction change") > 0
	& Contains(targetNames, "% x4_changed > 50") > 0;

If(!schemaMatch | N Rows(source) != 1984,
	Save Text File(reportPath,
		"build_aborted=1\!Ncolumn_match=" || Char(schemaMatch)
		|| "\!Nsource_rows=" || Char(N Rows(source))
		|| "\!Ntarget_columns=" || Char(N Items(targetNames))
		|| "\!Nsource_columns=" || Char(N Items(sourceNames)) || "\!N"
	);
	Close(source, No Save);
	Close(dt, No Save);
	Exit();
);

dt << Save As(outputPath);
dt << Select All Rows;
dt << Delete Rows;
dt << Add Rows(N Rows(source));

formulaColumns = {
	"close to boundary old",
	"distance to boundary",
	"confidence of counterfactual - 50%",
	"participant training accuracy",
	"CRT binarized"
};

For(columnIndex = 1, columnIndex <= N Items(sourceNames), columnIndex++,
	columnName = sourceNames[columnIndex];
	If(!Contains(formulaColumns, columnName),
		Column(dt, columnName) << Set Values(Column(source, columnName) << Get Values)
	);
);

dt << Recalculate;
Column(dt, "cognitive model v0.1 family") << Set Property("Notes", "Winning v0.1 family selected by five-fold cross-validated selection NLL, then conditional amount MAE.");
Column(dt, "explanation reliance (η)") << Set Property("Notes", "Balance between explanation-derived relevance (1) and label-based diagnosticity (0); fixed at 0 for no explanation.");
Column(dt, "global relevance reliance (α)") << Set Property("Notes", "Feature-contribution family only: balance between global relevance (1) and instance-local opposition (0).");
Column(dt, "additive change margin (ρ)") << Set Property("Notes", "Extra range-normalized movement added in the predicted direction for each selected feature.");
Column(dt, "exemplar locality (λ)") << Set Property("Notes", "Weighted-examples family only: higher values concentrate retrieval on more similar remembered examples.");
Column(dt, "remembered-change reliance (β)") << Set Property("Notes", "Weighted-examples family: balance between copying remembered changes (1) and moving toward remembered endpoints (0).");
Column(dt, "age treated as actionable (0/1)") << Set Property("Notes", "Whether Age was allowed among candidate edited features in cognitive model v0.1.");
dt << Save;

participants = Associative Array();
trainingRows = 0;
testingRows = 0;
attributionParticipants = Associative Array();
counterfactualParticipants = Associative Array();
noneParticipants = Associative Array();
trainingIds = {
	"160100", "160101", "160102", "160103", "160104", "160105",
	"160106", "160107", "160108", "160109", "160110", "160111"
};
testingIds = {
	"160200", "160201", "160202", "160203", "160204",
	"160205", "160206", "160207", "160208", "160209",
	"160210", "160211", "160212", "160213", "160214",
	"160215", "160216", "160217", "160218", "160219"
};
trainingIdCounts = Associative Array();
testingIdCounts = Associative Array();
For(idIndex = 1, idIndex <= N Items(trainingIds), idIndex++,
	trainingIdCounts[trainingIds[idIndex]] = 0
);
For(idIndex = 1, idIndex <= N Items(testingIds), idIndex++,
	testingIdCounts[testingIds[idIndex]] = 0
);
trainingMetricNonmissing = 0;
testingMetricMissing = 0;
sparsityMismatch = 0;
actionabilityMismatch = 0;
formulaMismatch = 0;
domainMismatch = 0;
modelFamilyMissing = 0;
commonParameterMissing = 0;
familyParameterMismatch = 0;

For(rowIndex = 1, rowIndex <= N Rows(dt), rowIndex++,
	participant = Char(Column(dt, "participant")[rowIndex]);
	participants[participant] = 1;
	phase = Lowercase(Char(Column(dt, "phase")[rowIndex]));
	xai = Lowercase(Char(Column(dt, "xai")[rowIndex]));
	instanceId = Char(Column(dt, "instance id")[rowIndex]);
	If(Contains(trainingIds, instanceId),
		trainingIdCounts[instanceId] = trainingIdCounts[instanceId] + 1
	);
	If(Contains(testingIds, instanceId),
		testingIdCounts[instanceId] = testingIdCounts[instanceId] + 1
	);
	If(Lowercase(Char(Column(dt, "domain")[rowIndex])) != "diabetes", domainMismatch++);
	If(xai == "attribution", attributionParticipants[participant] = 1);
	If(xai == "counterfactual", counterfactualParticipants[participant] = 1);
	If(xai == "none", noneParticipants[participant] = 1);
	modelFamily = Lowercase(Char(Column(dt, "cognitive model v0.1 family")[rowIndex]));
	If(modelFamily == "", modelFamilyMissing++);
	If(
		Is Missing(Column(dt, "explanation reliance (η)")[rowIndex])
		| Is Missing(Column(dt, "additive change margin (ρ)")[rowIndex])
		| Is Missing(Column(dt, "age treated as actionable (0/1)")[rowIndex]),
		commonParameterMissing++
	);
	If(
		modelFamily == "feature contribution"
		& (
			Is Missing(Column(dt, "global relevance reliance (α)")[rowIndex])
			| !Is Missing(Column(dt, "exemplar locality (λ)")[rowIndex])
			| !Is Missing(Column(dt, "remembered-change reliance (β)")[rowIndex])
		),
		familyParameterMismatch++
	);
	If(
		modelFamily == "weighted examples"
		& (
			!Is Missing(Column(dt, "global relevance reliance (α)")[rowIndex])
			| Is Missing(Column(dt, "exemplar locality (λ)")[rowIndex])
			| Is Missing(Column(dt, "remembered-change reliance (β)")[rowIndex])
		),
		familyParameterMismatch++
	);

	If(phase == "training",
		trainingRows++;
		If(
			!Is Missing(Column(dt, "sparsity")[rowIndex])
			| !Is Missing(Column(dt, "proximity")[rowIndex])
			| !Is Missing(Column(dt, "plausibility")[rowIndex])
			| !Is Missing(Column(dt, "plausibility (subset)")[rowIndex])
			| !Is Missing(Column(dt, "actionability (0/1)")[rowIndex])
			| !Is Missing(Column(dt, "boundary distance original")[rowIndex]),
			trainingMetricNonmissing++
		),
		testingRows++;
		If(
			Is Missing(Column(dt, "sparsity")[rowIndex])
			| Is Missing(Column(dt, "proximity")[rowIndex])
			| Is Missing(Column(dt, "plausibility")[rowIndex])
			| Is Missing(Column(dt, "plausibility (subset)")[rowIndex])
			| Is Missing(Column(dt, "actionability (0/1)")[rowIndex])
			| Is Missing(Column(dt, "boundary distance original")[rowIndex]),
			testingMetricMissing++
		);
		changed = 0;
		For(featureIndex = 1, featureIndex <= 5, featureIndex++,
			changed += Column(dt, "x_" || Char(featureIndex) || "_changed")[rowIndex]
		);
		If(Abs(Column(dt, "sparsity")[rowIndex] - (1 - changed / 5)) > 1e-9, sparsityMismatch++);
		expectedActionability = Column(dt, "x_5_changed")[rowIndex] == 0;
		If(Column(dt, "actionability (0/1)")[rowIndex] != expectedActionability, actionabilityMismatch++);
	);
	expectedCrtBinary = Column(dt, "CRT-2 score (0-4)")[rowIndex] > 2;
	If(Column(dt, "CRT binarized")[rowIndex] != expectedCrtBinary, formulaMismatch++);
);

trainingIdMismatch = 0;
testingIdMismatch = 0;
For(idIndex = 1, idIndex <= N Items(trainingIds), idIndex++,
	If(trainingIdCounts[trainingIds[idIndex]] != 62, trainingIdMismatch++)
);
For(idIndex = 1, idIndex <= N Items(testingIds), idIndex++,
	If(testingIdCounts[testingIds[idIndex]] != 62, testingIdMismatch++)
);
updatedScripts = dt << Get Table Script Names;
scriptNamesMatch = Char(originalScripts) == Char(updatedScripts);
text = "build_aborted=0\!N";
text ||= "rows=" || Char(N Rows(dt)) || " columns=" || Char(N Cols(dt)) || " participants=" || Char(N Items(participants)) || "\!N";
text ||= "training_rows=" || Char(trainingRows) || " testing_rows=" || Char(testingRows) || "\!N";
text ||= "xai_participants=attribution:" || Char(N Items(attributionParticipants))
	|| ",counterfactual:" || Char(N Items(counterfactualParticipants))
	|| ",none:" || Char(N Items(noneParticipants)) || "\!N";
text ||= "training_id_mismatch=" || Char(trainingIdMismatch) || " testing_id_mismatch=" || Char(testingIdMismatch) || "\!N";
text ||= "domain_mismatch=" || Char(domainMismatch) || "\!N";
text ||= "model_family_missing=" || Char(modelFamilyMissing) || " common_parameter_missing=" || Char(commonParameterMissing) || " family_parameter_mismatch=" || Char(familyParameterMismatch) || "\!N";
text ||= "training_metric_nonmissing=" || Char(trainingMetricNonmissing) || " testing_metric_missing=" || Char(testingMetricMissing) || "\!N";
text ||= "sparsity_mismatch=" || Char(sparsityMismatch) || " actionability_mismatch=" || Char(actionabilityMismatch) || " formula_mismatch=" || Char(formulaMismatch) || "\!N";
text ||= "original_scripts=" || Char(N Items(originalScripts)) || " updated_scripts=" || Char(N Items(updatedScripts)) || "\!N";
text ||= "script_names_match=" || Char(scriptNamesMatch) || "\!N";
Save Text File(reportPath, text);

Close(source, No Save);
Close(dt, No Save);
Exit();
