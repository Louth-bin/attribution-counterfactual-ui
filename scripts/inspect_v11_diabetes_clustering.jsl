Names Default To Here(1);

rootPath = "C:/Users/Louth/Desktop/counterfactual/attribution-counterfactual-ui/";
inputPath = Convert File Path(rootPath || "qualtrics/qualtrics_results_v1.1.jmp", Windows);
reportPath = Convert File Path(rootPath || "qualtrics/v1.1_schema_inspection.txt", Windows);
csvPath = Convert File Path(rootPath || "qualtrics/qualtrics_results_v1.1.schema-export.csv", Windows);

dt = Open(inputPath, Invisible);
columnNames = dt << Get Column Names("String");
scriptNames = dt << Get Table Script Names;

text = "rows=" || Char(N Rows(dt)) || "\!N";
text ||= "columns=" || Char(N Cols(dt)) || "\!N";
text ||= "scripts=" || Char(scriptNames) || "\!N";
text ||= "COLUMN DETAILS\!N";

For(i = 1, i <= N Items(columnNames), i++,
	col = Column(dt, columnNames[i]);
	text ||= Char(i) || "\!T" || columnNames[i]
		|| "\!Ttype=" || Char(col << Get Data Type)
		|| "\!Tmodeling=" || Char(col << Get Modeling Type)
		|| "\!Tformula=" || Char(col << Get Formula)
		|| "\!Tnotes=" || Char(col << Get Property("Notes"))
		|| "\!N";
);

Save Text File(reportPath, text);
dt << Save As(csvPath);
Close(dt, No Save);
Exit();
