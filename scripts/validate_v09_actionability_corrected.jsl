Names Default To Here(1);

rootPath = "$DESKTOP/counterfactual/attribution-counterfactual-ui/qualtrics/";
inputPath = Convert File Path(rootPath || "qualtrics_results_v0.9.actionability-corrected.jmp", Windows);
outputPath = Convert File Path(rootPath || "v0.9_actionability_corrected_validation.txt", Windows);
columnName = "actionability (0/1)";

dataTable = Open(inputPath, Invisible);
columnNames = dataTable << Get Column Names("String");
ruleMismatches = 0;
trainingNonmissing = 0;
testingMissing = 0;
nonbinary = 0;
housingZero = 0;
diabetesZero = 0;
safelimitZero = 0;

For(rowIndex = 1, rowIndex <= N Rows(dataTable), rowIndex++,
	phaseValue = Lowercase(Char(Column(dataTable, "phase")[rowIndex]));
	domainValue = Lowercase(Char(Column(dataTable, "domain")[rowIndex]));
	x2Changed = Num(Char(Column(dataTable, "x_2_changed")[rowIndex]));
	x4Changed = Num(Char(Column(dataTable, "x_4_changed")[rowIndex]));
	x5Changed = Num(Char(Column(dataTable, "x_5_changed")[rowIndex]));
	If(Is Missing(x2Changed), x2Changed = 0);
	If(Is Missing(x4Changed), x4Changed = 0);
	If(Is Missing(x5Changed), x5Changed = 0);
	actualScore = Column(dataTable, columnName)[rowIndex];

	If(phaseValue == "training",
		If(!Is Missing(actualScore), trainingNonmissing++),
		expectedScore = 1;
		If(domainValue == "diabetes" & x5Changed != 0, expectedScore = 0);
		If(domainValue == "safelimit" & (x2Changed != 0 | x4Changed != 0), expectedScore = 0);
		If(Is Missing(actualScore),
			testingMissing++,
			If(actualScore != 0 & actualScore != 1, nonbinary++);
			If(actualScore != expectedScore, ruleMismatches++);
			If(domainValue == "housing" & actualScore == 0, housingZero++);
			If(domainValue == "diabetes" & actualScore == 0, diabetesZero++);
			If(domainValue == "safelimit" & actualScore == 0, safelimitZero++);
		)
	);
);

summaryText = "rows=" || Char(N Rows(dataTable)) || "\!N";
summaryText ||= "columns=" || Char(N Cols(dataTable)) || "\!N";
summaryText ||= "new_column_position=" || Char(Contains(columnNames, columnName)) || "\!N";
summaryText ||= "old_column_present=" || Char(Contains(columnNames, "plausible and actionable (0/1)")) || "\!N";
summaryText ||= "training_nonmissing=" || Char(trainingNonmissing) || "\!N";
summaryText ||= "testing_missing=" || Char(testingMissing) || "\!N";
summaryText ||= "nonbinary=" || Char(nonbinary) || "\!N";
summaryText ||= "rule_mismatches=" || Char(ruleMismatches) || "\!N";
summaryText ||= "zeros_by_domain=housing:" || Char(housingZero) || " diabetes:" || Char(diabetesZero) || " safelimit:" || Char(safelimitZero) || "\!N";
summaryText ||= "script_count=" || Char(N Items(dataTable << Get Table Script Names)) || "\!N";

Save Text File(outputPath, summaryText);
Close(dataTable, No Save);
Exit();
